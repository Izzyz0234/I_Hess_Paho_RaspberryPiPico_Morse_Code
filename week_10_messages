import paho.mqtt.client as mqtt
import re
# The callback for when the client receives a CONNACK response from the server.
def on_connect(client, userdata, flags, reason_code, properties):
    print(f"Connected with result code {reason_code}")
    # Subscribing in on_connect() means that if we lose the connection and
    # reconnect then subscriptions will be renewed.
    client.subscribe("TAFE//i-hess/morse-code")
    # The callback for when a PUBLISH message is received from the server.

def on_message(client, userdata, msg):
    MESSAGE = (str(msg.payload))

    # Remove unesasary 
    MESSAGE = re.sub(r',|"|b', '', MESSAGE)
    MESSAGE = re.sub(r"[\[\]\']", '', MESSAGE)

    # Turn spaces into = or nothing to seperate into words
    MESSAGE = re.sub(r' {2}', '=', MESSAGE)
    MESSAGE = re.sub(r' {1}', '', MESSAGE)

    # convert to MESSAGE list into LETTERS list with each item being its own letter
    LETTERS = re.split(r'={1,2}', MESSAGE)
    
    DECIFER = {'._': 'A', '_...': 'B', '_._.': 'C', '_..': 'D', '.': 'E', '.._.': 'F', '__.': 'G',
                '....': 'H', '..': 'I', '.___': 'J', '_,_': 'K', '._..': 'L', '__': 'M', '_.': 'N', '___': 'O', '.__.': 'P', 
                '__._': 'Q', '._.': 'R', '...': 'S', '_': 'T', '.._': 'U', '..._': 'V', 
                '.__': 'W', '_.._': 'X', '_.__': 'Y', '__..': 'Z', '': ' '}

    NEWMESSAGE = ""
    
    for i in range(len(LETTERS)):
        if LETTERS[i] in DECIFER:
            NEWMESSAGE += DECIFER[LETTERS[i]]

            # LETTERS[i] = DECIFER[LETTERS[i]]

    # LETTERS = ", ".join(LETTERS)
    # NEWMESSAGE = re.sub(r',|"|b', '', LETTERS)
    # NEWMESSAGE = re.sub(r' {1}', '', NEWMESSAGE)    
    
            

    # MESSAGE = re.split(r'={3}', MESSAGE)

    print('Deciferer:', DECIFER, '\nMessage: ', MESSAGE, "\nLetters:", LETTERS, "\nNew Message:", NEWMESSAGE)
    print(str(msg.payload)[6])
    # if (DECIFER in str(msg.payload)):
    #     print(msg.topic+": "+str(msg.payload))
    print(msg.topic+": "+str(msg.payload))
    # if the messages has an order that matches a string in DECIFER print off that letter. such as MESSAGE incudes = ".", "_" print("A")

mqttc = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
mqttc.on_connect = on_connect
mqttc.on_message = on_message
mqttc.connect("mqtt-dashboard.com")
# mqttc.publish('TAFE//i-hess/morse-code','hello')
mqttc.loop_forever()