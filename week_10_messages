import paho.mqtt.client as mqtt
import re, time

ADAFRUIT_AIO_USERNAME = "Izzy0234"
ADAFRUIT_AIO_KEY = ""

MQTT_BROKER = "mqtt-dashboard.com"
MQTT_ADA_BROKER = "io.adafruit.com"

TOPIC_HIVEMQ = "TAFE/i-hess/morse-code"
TOPIC_ADA_BUTTON = "Izzy0234/feeds/morse-code.button"

# The callback for when the client receives a CONNACK response from the server.
def on_connect(client, userdata, flags, reason_code, properties):
    print(f"Connected with result code {reason_code}")
    # Subscribing in on_connect() means that if we lose the connection and
    # reconnect then subscriptions will be renewed.
    client.subscribe(TOPIC_HIVEMQ)

def on_message(client, userdata, msg):
    if msg.topic == TOPIC_HIVEMQ:
        MESSAGE = (str(msg.payload))

        # Remove unesasary 
        MESSAGE = re.sub(r',|"|b', '', MESSAGE)
        MESSAGE = re.sub(r"[\[\]\']", '', MESSAGE)

        # Turn spaces into = or nothing to seperate into words
        MESSAGE = re.sub(r' {2}', '=', MESSAGE)
        MESSAGE = re.sub(r' {1}', '', MESSAGE)

        # convert to MESSAGE list into LETTERS list with each item being its own letter
        LETTERS = re.split(r'={1,2}', MESSAGE)

        # Conversions for morse code to letters and numbers
        DECIFER = {'._': 'A', '_...': 'B', '_._.': 'C', '_..': 'D', '.': 'E', '.._.': 'F', '__.': 'G',
                    '....': 'H', '..': 'I', '.___': 'J', '_,_': 'K', '._..': 'L', '__': 'M', '_.': 'N', 
                    '___': 'O', '.__.': 'P', '__._': 'Q', '._.': 'R', '...': 'S', '_': 'T', '.._': 'U',
                    '..._': 'V', '.__': 'W', '_.._': 'X', '_.__': 'Y', '__..': 'Z', '': ' ', 
                    '.____': '1', '..___': '2', '...__': '3', '...._': '4', '.....': '5', 
                    '_....': '6', '__...': '7', '___..': '8', '____.': '9', '_____': '0'}

        NEWMESSAGE = ""
        all_symbols_converted = True

        # foreach item in DECIFER and LETTERS if they match replace LETTERS morse code to DECIFER letter. If doesnt convert replace with *
        for i in range(len(LETTERS)):
            if LETTERS[i] in DECIFER:
                NEWMESSAGE += DECIFER[LETTERS[i]]
            else:
                NEWMESSAGE += "*"
                all_symbols_converted = False

        # Print progress converting values
        print(msg.topic+": "+str(msg.payload))
        print('Message: ', MESSAGE, "\nLetters:", LETTERS, "\nNew Message:", NEWMESSAGE)
        print('Properly Converted:', all_symbols_converted)

        if all_symbols_converted:
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledGreen2.on()')
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledRed2.off()')

            mqttc_ada.publish("Izzy0234/feeds/morse-code.button", "ON")
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledred2", 'OFF')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledgreen2", 'ON')

        else:
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledRed2.on()')
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledGreen2.off()')

            mqttc_ada.publish("Izzy0234/feeds/morse-code.button", "OFF")
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledgreen2", 'OFF')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledred2", 'ON')

        # if the messages has an order that matches a string in DECIFER print off that letter. such as MESSAGE incudes = ".", "_" print("A")

#Connected to io.adafruit.com broker
def on_connect_ada(client, userdata, flags, reason_code, properties):
    print(f"Connected to {MQTT_ADA_BROKER} with result code {reason_code}")
    # Subscribing in on_connect() means that if we lose the connection and
    # reconnect then subscriptions will be renewed.
    client.subscribe(TOPIC_ADA_BUTTON)

def on_message_ada(client, userdata, msg):
    if msg.topic == TOPIC_ADA_BUTTON:
        print(msg.topic+": "+str(msg.payload))

        if str(msg.payload) == "b'ON'":
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledGreen2.on()')
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledRed2.off()')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledred2", 'OFF')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledgreen2", 'ON')

        elif str(msg.payload) == "b'OFF'":
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledRed2.on()')
            mqttc.publish('TAFE/i-hess/morse-code-respond','ledGreen2.off()')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledgreen2", 'OFF')
            mqttc_ada.publish("Izzy0234/feeds/morse-code.ledred2", 'ON')

    

mqttc = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
mqttc.on_connect = on_connect
mqttc.on_message = on_message
mqttc.connect(MQTT_BROKER)

mqttc_ada = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
mqttc_ada.on_connect = on_connect_ada
mqttc_ada.username_pw_set(ADAFRUIT_AIO_USERNAME, ADAFRUIT_AIO_KEY)
mqttc_ada.on_message = on_message_ada
mqttc_ada.connect(MQTT_ADA_BROKER, 1883, 60)  # Connect to Adafruit IO broker

# mqttc.loop_forever()
mqttc.loop_start()
mqttc_ada.loop_start()

while True:
    time.sleep(1)  # Keep the main thread alive to allow MQTT loop to run
    mqttc_ada.on_message = on_message_ada
mqttc.loop_stop()  # Stop the MQTT loop when done
mqttc_ada.loop_stop()  # Stop the MQTT loop when done

